{
  "name": "velocity-swimming",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "images:generate": "node scripts/media/generate-site-photos.mjs",
    "predev": "npm run images:generate",
    "dev": "next dev",
    "prebuild": "npm run images:generate",
    "build": "node scripts/updates/build.mjs && node scripts/swim-resources/check-private-artifacts.mjs",
    "start": "next start",
    "lint": "eslint src scripts tests *.mjs *.mts --max-warnings 0",
    "test:commerce": "node scripts/test-commerce.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:commerce && npm run test:calendar && npm run test:swim-resources && npm run test:workshare && npm run test:updates",
    "test:swim-resources": "vitest run",
    "test:rules": "npm run test:database",
    "verify": "npm run check:secrets && npm run lint && npm run typecheck && npm test && npm run test:database && npm run build",
    "check:secrets": "node scripts/check-google-api-keys.mjs",
    "test:calendar": "node scripts/test-calendar.mjs",
    "test:workshare": "node --import ./scripts/workshare/register-typescript.mjs --test tests/workshare/*.test.ts && python3 tests/workshare/test_prepare_accounts.py",
    "test:workshare:database": "node --test tests/workshare-accounts.integration.mjs",
    "test:workshare:browser": "node scripts/workshare/accounts-browser-check.mjs",
    "test:workshare:tickets:browser": "node scripts/workshare/tickets-browser-check.mjs",
    "test:workshare:tickets:quantity:browser": "node scripts/workshare/ticket-quantity-browser-check.mjs",
    "test:workshare:tickets:database": "node --test tests/workshare-tickets.integration.mjs",
    "test:workshare:summary:database": "node --test tests/workshare-account-summary.integration.mjs",
    "test:workshare:staff:database": "node --test tests/workshare-domain-staff.integration.mjs",
    "test:workshare:summary:browser": "node scripts/workshare/account-summary-browser-check.mjs",
    "test:database": "node --test tests/unified.integration.mjs && npm run test:records:database && npm run test:times:database && npm run test:moderation:database && npm run test:profile:database && npm run test:data:database && npm run test:attendance:database",
    "test:profile:database": "node --test tests/account-profile.integration.mjs tests/account-athletes.integration.mjs",
    "test:profile:browser": "node scripts/unified/account-profile-browser-check.mjs",
    "test:passkey:browser": "node scripts/unified/account-passkey-browser-check.mjs",
    "test:moderation:database": "node --test tests/result-moderation.integration.mjs",
    "test:moderation:browser": "node scripts/collection/moderation-browser-check.mjs",
    "test:records:database": "node --test tests/records.integration.mjs tests/team-records.integration.mjs tests/official-meet-leadoff.integration.mjs",
    "test:records:browser": "node scripts/collection/records-browser-check.mjs",
    "test:browser": "npm run test:data:browser",
    "dev:local": "node scripts/unified/dev.mjs --hostname 127.0.0.1 --port 3001",
    "seed:local": "node scripts/unified/seed.mjs",
    "verify:browser": "npm run test:browser",
    "db:types": "supabase gen types --local > src/lib/supabase/database.types.ts",
    "test:times:database": "node --import ./scripts/workshare/register-typescript.mjs --test tests/times.integration.mjs && node --test tests/my-times.integration.mjs",
    "test:times:browser": "node --import ./scripts/workshare/register-typescript.mjs scripts/collection/times-browser-check.mjs",
    "test:my-times:browser": "node scripts/collection/my-times-browser-check.mjs",
    "test:times:layout": "node scripts/collection/times-page-tweaks-browser-check.mjs",
    "test:times:loading": "node scripts/collection/times-loading-browser-check.mjs",
    "test:updates": "node --test tests/updates/*.test.ts",
    "test:updates:browser": "node scripts/updates/browser-check.mjs",
    "test:home:photos": "node scripts/media/home-photos-browser-check.mjs",
    "test:data:database": "node --test tests/data-management.integration.mjs",
    "test:data:retirement": "node --test tests/data-retirement.integration.mjs",
    "test:data:browser": "node --import ./scripts/workshare/register-typescript.mjs scripts/results/browser-check.mjs",
    "test:attendance:database": "node --test tests/attendance.integration.mjs"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fflate": "0.8.3",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.12",
    "node-ical": "^0.26.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.2.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^7.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "iconv-lite": "^0.7.3",
    "jsdom": "^31.0.1",
    "playwright": "^1.64.0",
    "prettier": "3.9.9",
    "sharp": "0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
